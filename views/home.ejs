<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="NOOK — Connect with real people and start meaningful conversations.">
    <meta name="theme-color" content="#050a24">
    <title>NOOK — Connect with Real People</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/home.css">
</head>
<body class="nook-home-page">
    <div class="scroll-progress" id="scrollProgress" aria-hidden="true"></div>
    <div class="cursor-glow" id="cursorGlow" aria-hidden="true"></div>

    <main>
        <!-- =====================================================
             HERO
             The supplied NOOK artwork stays untouched.
             Functional transparent hotspots sit above it.
             ===================================================== -->
        <section class="hero-section" id="home" aria-label="NOOK home">
            <div class="hero-shell">
                <img
                    src="/images/nook-home.png"
                    alt="NOOK — Connect with Real People"
                    class="nook-home-art"
                >

                <!-- Navigation hotspots matching the artwork -->
                <a class="hotspot hotspot-home" href="#home" aria-label="Home"></a>
                <a class="hotspot hotspot-about" href="#about" aria-label="About"></a>
                <a class="hotspot hotspot-features" href="#features" aria-label="Features"></a>
                <a class="hotspot hotspot-contact" href="#contact" aria-label="Contact"></a>

                <!-- Account / app actions -->
                <a class="hotspot hotspot-login" href="/login" aria-label="Login"></a>
                <a class="hotspot hotspot-signup" href="/register" aria-label="Sign Up"></a>
                <a class="hotspot hotspot-messenger" href="<%= userLoggedIn ? '/chat' : '/login' %>" aria-label="Open Messenger"></a>
                <button class="hotspot hotspot-call" type="button" id="callComingSoon" aria-label="Call coming soon"></button>
            </div>

            <button class="scroll-cue" id="scrollCue" type="button" aria-label="Scroll to explore">
                <span>Scroll to explore</span>
                <span class="scroll-cue-arrow">↓</span>
            </button>
        </section>

        <!-- =====================================================
             ABOUT
             ===================================================== -->
        <section class="content-section about-section" id="about">
            <div class="section-orb orb-one"></div>
            <div class="section-orb orb-two"></div>

            <div class="section-inner two-column">
                <div class="section-copy reveal">
                    <span class="eyebrow">ABOUT NOOK</span>
                    <h2>A space made for <span>real conversations.</span></h2>
                    <p>
                        NOOK brings people together in a simple, modern space where
                        conversations can feel natural, personal and effortless.
                    </p>
                    <p>
                        Start with a message, discover people around your interests,
                        and build meaningful connections at your own pace.
                    </p>

                    <a class="primary-button" href="<%= userLoggedIn ? '/chat' : '/login' %>">
                        <span>Open Messenger</span>
                        <span>→</span>
                    </a>
                </div>

                <div class="about-card reveal reveal-delay-2">
                    <div class="floating-dot dot-a"></div>
                    <div class="floating-dot dot-b"></div>
                    <div class="about-card-icon">✦</div>
                    <h3>Your space. Your people.</h3>
                    <p>
                        A focused social experience designed around conversations,
                        presence and genuine connections.
                    </p>
                    <div class="mini-stat-row">
                        <div>
                            <strong>01</strong>
                            <span>Connect</span>
                        </div>
                        <div>
                            <strong>02</strong>
                            <span>Chat</span>
                        </div>
                        <div>
                            <strong>03</strong>
                            <span>Discover</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =====================================================
             FEATURES
             ===================================================== -->
        <section class="content-section features-section" id="features">
            <div class="section-inner">
                <div class="section-heading reveal">
                    <span class="eyebrow">FEATURES</span>
                    <h2>Everything you need to <span>stay connected.</span></h2>
                    <p>Built around fast conversations, simple discovery and a comfortable chat experience.</p>
                </div>

                <div class="feature-grid">
                    <article class="feature-card reveal">
                        <div class="feature-icon">💬</div>
                        <h3>Real-time Chat</h3>
                        <p>Send and receive messages instantly with a smooth, focused conversation experience.</p>
                        <span class="feature-number">01</span>
                    </article>

                    <article class="feature-card reveal reveal-delay-1">
                        <div class="feature-icon">👥</div>
                        <h3>Discover People</h3>
                        <p>Find new people and explore the social side of NOOK when you are ready.</p>
                        <span class="feature-number">02</span>
                    </article>

                    <article class="feature-card reveal reveal-delay-2">
                        <div class="feature-icon">🔒</div>
                        <h3>Privacy First</h3>
                        <p>Your account and conversations stay inside the application experience.</p>
                        <span class="feature-number">03</span>
                    </article>

                    <article class="feature-card reveal reveal-delay-3">
                        <div class="feature-icon">⚡</div>
                        <h3>Fast & Smooth</h3>
                        <p>A lightweight interface with real-time updates and responsive interactions.</p>
                        <span class="feature-number">04</span>
                    </article>
                </div>
            </div>
        </section>

        <!-- =====================================================
             CONTACT
             ===================================================== -->
        <section class="content-section contact-section" id="contact">
            <div class="contact-glow"></div>
            <div class="section-inner contact-inner reveal">
                <span class="eyebrow">CONTACT</span>
                <h2>Let’s keep the conversation <span>going.</span></h2>
                <p>
                    Have an idea, feedback or a question about NOOK? Send us a message
                    and we can build the next part together.
                </p>

                <div class="contact-actions">
                    <a class="primary-button" href="mailto:hello@nook.chat">
                        <span>Email NOOK</span>
                        <span>↗</span>
                    </a>
                    <a class="secondary-button" href="<%= userLoggedIn ? '/chat' : '/login' %>">
                        <span>Go to Messenger</span>
                        <span>→</span>
                    </a>
                </div>
            </div>
        </section>

        <footer class="nook-footer">
            <div>
                <strong>NOOK</strong>
                <span>Connect with real people.</span>
            </div>
            <div class="footer-links">
                <a href="#home">Home</a>
                <a href="#about">About</a>
                <a href="#features">Features</a>
                <a href="#contact">Contact</a>
            </div>
            <span class="footer-copy">© <%= new Date().getFullYear() %> NOOK</span>
        </footer>
    </main>

    <button class="back-to-top" id="backToTop" type="button" aria-label="Back to top">↑</button>

    <script src="/js/home.js"></script>
</body>
</html>
