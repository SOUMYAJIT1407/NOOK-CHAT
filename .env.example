# =============================================================================================
# NOOK CHAT — configuration template.   Copy to ".env" for local use:   cp .env.example .env
# On a cloud host (Render, Railway, Fly, Heroku, ...) do NOT upload a .env file: enter these
# values in the host's "Environment" / "Variables" settings instead.
# Never commit real passwords. This file only contains placeholders.
# =============================================================================================

# ---- Required ------------------------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas: Connect -> Drivers). URL-encode special characters in
# the password (@ becomes %40, # becomes %23 ...).
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/online_chat?retryWrites=true&w=majority

# A long random string that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# With NODE_ENV=production the server refuses to start while this is missing or weak.
SESSION_SECRET=replace_with_a_long_random_secret

# ---- Server --------------------------------------------------------------------------------
PORT=3000
# NODE_ENV=production                 # set on cloud hosts: HTTPS cookies, caching, strict checks
# TRUST_PROXY=1                       # number of proxies in front of the app (default: 1 in production)
# SESSION_DAYS=7                      # how long a login lasts

# ---- Files & images ------------------------------------------------------------------------
# STORAGE_DRIVER=gridfs               # gridfs (default): files live in MongoDB, survive redeploys
#                                     # local: files live in UPLOAD_DIR — needs a persistent disk
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=25

# ---- Messages ------------------------------------------------------------------------------
# DELETE_FOR_EVERYONE_MINUTES=0       # 0 = always allowed; e.g. 60 = only within an hour of sending

# ---- Optional: "Continue with Google" ------------------------------------------------------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials and add the
# callback URL below as an "Authorized redirect URI".
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_CALLBACK_URL=https://your-app.example.com/auth/google/callback

# ---- Optional: calls across strict firewalls / mobile networks (TURN relay) -------------------
# TURN_URL=turn:your.turn.server:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=secret

# ---- Optional: advanced ----------------------------------------------------------------------
# DNS_SERVERS=8.8.8.8,8.8.4.4         # local default; empty in production (the host's DNS is used)
# CORS_ORIGIN=https://app.example.com # only if the web page is served from a different domain
# AUTH_RATE_LIMIT=30                  # login/register attempts per IP per 15 minutes
